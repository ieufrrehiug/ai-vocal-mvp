PORT=3000
MODEL_BACKEND=demo
JOB_TTL_HOURS=24

# Auto-enabled when the local VoxCPM Python environment and model both exist.
# VOXCPM_ENABLED=true
# VOXCPM_MODEL=E:/path/to/VoxCPM/pretrained_models/VoxCPM2
# VOXCPM_DEVICE=cuda
# VOXCPM_PYTHON=E:/path/to/VoxCPM/.venv/Scripts/python.exe

# 推荐本机 RTX 4060：VoxCPM2 + Seed-VC，全程不上传音频。
# MODEL_BACKEND=seedvc
# SEEDVC_ROOT=E:/path/to/Seed-VC
# SEEDVC_PYTHON=E:/path/to/Seed-VC/.venv/Scripts/python.exe
# SEEDVC_STEPS=50
# SEEDVC_CFG=0.7

# 可选：配置后开放 MP3/M4A/AAC/FLAC/OGG/WEBM 上传。
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# SoulX-Singer-SVC GPU 部署时填写：
# MODEL_BACKEND=soulx
# SOULX_ROOT=/opt/SoulX-Singer
# SOULX_PYTHON=/opt/conda/envs/soulxsinger/bin/python
# SOULX_DEVICE=cuda:0
# SOULX_FP16=true
# SOULX_N_STEPS=32
# SOULX_CFG=1.0

# 推荐：RunPod Serverless 48GB 云端 GPU（密钥只保存在服务端）：
# MODEL_BACKEND=runpod
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_KEY=
# RUNPOD_TIMEOUT_SECONDS=900
